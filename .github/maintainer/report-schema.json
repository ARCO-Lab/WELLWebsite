{
  "type": "object",
  "properties": {
    "summary": {"type": "string"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"what": {"type": "string"}, "url": {"type": "string"}},
        "required": ["what"]
      }
    },
    "pull_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "branch": {"type": "string", "pattern": "^maint/[a-z0-9][a-z0-9-]{0,59}$"},
          "title": {"type": "string", "maxLength": 120},
          "body": {"type": "string", "maxLength": 20000},
          "risk": {"enum": ["low", "high"]},
          "audit": {"enum": ["approved", "findings"]}
        },
        "required": ["branch", "title", "body", "risk", "audit"]
      }
    },
    "skipped": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["summary", "actions", "pull_requests", "skipped", "errors"]
}
